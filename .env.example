# Shared password for /ads. Set this in Vercel for Production and Preview, then redeploy.
# Never commit the value. The server compares the login form to this variable and
# stores an httpOnly session cookie. If it is missing, the portal stays closed.
ADS_PORTAL_PASSWORD=

# Clerk (invite-only). The portal falls back to the publishable key already
# used by the fde-hello site if NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY is unset.
# Set both for a dedicated production instance.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Optional comma-separated allowlist. Enforced when CLERK_SECRET_KEY is set
# (or when the session token already contains an email claim).
ADS_PORTAL_ALLOWED_EMAILS=

# Amazon Advertising API. Leave blank for dry-run: the desk says "API not connected"
# and shows labeled sample data. Never commit real values.
AMAZON_ADS_CLIENT_ID=
AMAZON_ADS_CLIENT_SECRET=
AMAZON_ADS_REFRESH_TOKEN=
AMAZON_ADS_PROFILE_ID=
# na, eu, or fe
AMAZON_ADS_REGION=na
# Optional hard caps. Live budget and bid writes are refused until these are positive numbers.
# ADS_MAX_DAILY_BUDGET=50
# ADS_MAX_BID=2
# Owner-only key for the one-time Login with Amazon grant. The portal password is not enough.
# ADS_OAUTH_SETUP_KEY=
# Production return URL to register with Login with Amazon:
# https://fde-hello.vercel.app/api/ads/oauth/callback
# AMAZON_ADS_REDIRECT_URI=https://fde-hello.vercel.app/api/ads/oauth/callback
# AMAZON_ADS_API_BASE=
# AMAZON_ADS_TOKEN_URL=

# AI Gateway model used when a sentence is not a direct command.
# On Vercel, OIDC is used automatically. Locally set AI_GATEWAY_API_KEY or
# leave it unset and use the built-in command desk.
ADS_PORTAL_MODEL=openai/gpt-6-luna
# AI_GATEWAY_API_KEY=

# Local only. Ignored whenever VERCEL is set. Never enable this in production.
# ADS_PORTAL_DEV_BYPASS=1
